# Application environment: local, test, staging, or production.
FIREMARK_ENV=

# Select memory for local tests or supabase for production composition.
FIREMARK_REPOSITORY_BACKEND=

# Public base URL used when FIREMARK begins issuing public links.
FIREMARK_BASE_URL=

# FIREMARK signing material. Keep private signing keys out of source control.
# Configure a direct value or its corresponding file, never both.
FIREMARK_SIGNING_KEY=
FIREMARK_PUBLIC_KEY=
FIREMARK_SIGNING_KEY_FILE=
FIREMARK_PUBLIC_KEY_FILE=
FIREMARK_SIGNER_KEY_ID=

# Production Generate & Seal uses direct Base64 Ed25519 values.
# The public value may be omitted when it should be derived from the private value.
FIREMARK_SIGNING_PRIVATE_KEY_B64=
FIREMARK_SIGNING_PUBLIC_KEY_B64=

# Backblaze B2 S3 endpoint, for example https://s3.<region>.backblazeb2.com.
# Both buckets must be private. Never commit real names, key IDs, or application keys.
B2_ENDPOINT=
B2_REGION=

# Use credentials scoped only to the private assets bucket.
B2_ASSETS_BUCKET=
B2_ASSETS_KEY_ID=
B2_ASSETS_APP_KEY=

# Use separate credentials scoped only to the private Object-Lock-enabled vault bucket.
B2_VAULT_BUCKET=
B2_VAULT_KEY_ID=
B2_VAULT_APP_KEY=

# One day is permitted only for an explicit development smoke test.
# The current production retention target is 90 days; choose it deliberately.
FIREMARK_VAULT_RETENTION_DAYS=
FIREMARK_PRESIGNED_URL_TTL_SECONDS=

# Supabase live Control Plane checkpoint. Prefer current sb_publishable_ and sb_secret_ keys.
# Legacy anon and service_role JWT keys remain accepted only in their matching roles.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FIREMARK_PUBLIC_BASE_URL=
FIREMARK_DELIVERY_TTL_SECONDS=

# Server-side bearer credentials for generation and private delivery.
FIREMARK_ADMIN_API_KEY=
FIREMARK_DELIVERY_API_KEY=

# Official OpenAI image generation. All values remain empty in this template.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=
FIREMARK_GENERATION_TIMEOUT_SECONDS=
FIREMARK_MAX_GENERATED_IMAGE_BYTES=

# Reserved provider credentials from the repository foundation.
GMI_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
