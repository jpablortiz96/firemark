# Application environment: local, test, staging, or production.
FIREMARK_ENV=local

# Public base URL used when FIREMARK begins issuing public links.
FIREMARK_BASE_URL=

# FIREMARK signing material. Keep private signing keys out of source control.
# Configure a direct value or its corresponding file, never both.
FIREMARK_SIGNING_KEY=
FIREMARK_PUBLIC_KEY=
FIREMARK_SIGNING_KEY_FILE=
FIREMARK_PUBLIC_KEY_FILE=
FIREMARK_SIGNER_KEY_ID=

# Backblaze B2 S3 endpoint, for example https://s3.<region>.backblazeb2.com.
# Both buckets must be private. Never commit real names, key IDs, or application keys.
B2_ENDPOINT=
B2_REGION=

# Use credentials scoped only to the private assets bucket.
B2_ASSETS_BUCKET=
B2_ASSETS_KEY_ID=
B2_ASSETS_APP_KEY=

# Use separate credentials scoped only to the private Object-Lock-enabled vault bucket.
B2_VAULT_BUCKET=
B2_VAULT_KEY_ID=
B2_VAULT_APP_KEY=

# One day is permitted only for an explicit development smoke test.
# The current production retention target is 90 days; choose it deliberately.
FIREMARK_VAULT_RETENTION_DAYS=
FIREMARK_PRESIGNED_URL_TTL_SECONDS=300

# Supabase live Control Plane checkpoint. The publishable key is public; the backend key is not.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FIREMARK_PUBLIC_BASE_URL=
FIREMARK_DELIVERY_TTL_SECONDS=

# Generative media provider credentials.
GMI_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
