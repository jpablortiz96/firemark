# Application environment: local, test, staging, or production.
FIREMARK_ENV=

# Public base URL used when FIREMARK begins issuing public links.
FIREMARK_BASE_URL=

# FIREMARK signing material. Keep private signing keys out of source control.
FIREMARK_SIGNING_KEY=
FIREMARK_PUBLIC_KEY=
FIREMARK_SIGNER_KEY_ID=

# Backblaze B2 credentials and storage configuration.
B2_KEY_ID=
B2_APP_KEY=
B2_REGION=
B2_ENDPOINT=
B2_ASSETS_BUCKET=
B2_VAULT_BUCKET=

# Supabase server-side configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generative media provider credentials.
GMI_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
